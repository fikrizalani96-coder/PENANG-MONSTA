{
  "hosting": {
    "public": ".",
    "ignore": [
      "firebase.json", "firestore.rules", "**/.*", "**/node_modules/**",
      "functions/**", "tools/**", "shots/**", "*.md"
    ],
    "headers": [
      { "source": "**/*.@(js|css|svg)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=3600" }] },
      { "source": "vendor/**", "headers": [{ "key": "Cache-Control", "value": "public, max-age=604800" }] }
    ]
  },
  "functions": [{ "source": "functions", "codebase": "default", "runtime": "nodejs20" }],
  "firestore": { "rules": "firestore.rules" }
}
